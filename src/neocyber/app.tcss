/* NeoCyber TUI — Minimalistic Terminal Styling */

Screen {
    background: #0d0d0f;
    color: #f4f4f5;
    layout: vertical;
}

/* ── Top Header / Workspace bar ── */
#header-bar {
    dock: top;
    height: 1;
    background: #141416;
    color: #71717a;
    padding: 0 1;
    layout: horizontal;
}

#header-title {
    color: #22d3ee;
    text-style: bold;
    width: auto;
}

#header-context {
    color: #52525b;
    width: 1fr;
    text-align: right;
}

/* ── Conversation Area ── */
#chat-scroll, ChatArea {
    height: 1fr;
    background: #0d0d0f;
    overflow-y: scroll;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: #27272a #0d0d0f;
}

/* ── Messages & Spacing ── */
MessageView {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    layout: vertical;
}

.msg-user-row {
    height: auto;
    width: 100%;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
}

.msg-assistant-row {
    height: auto;
    width: 100%;
    margin-top: 0;
    padding-left: 2;
    color: #e4e4e7;
}

.assistant-author-badge {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 0;
    height: 1;
}

.plan-author-badge {
    color: #f59e0b;
    text-style: bold;
    margin-bottom: 0;
    height: 1;
}

/* ── Tool Execution Card ── */
ToolExecutionCard {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    background: #111113;
    border-left: tall #38bdf8;
    padding: 0 1;
}

ToolExecutionCard.status-running {
    border-left: tall #38bdf8;
}

ToolExecutionCard.status-completed {
    border-left: tall #10b981;
}

ToolExecutionCard.status-failed {
    border-left: tall #ef4444;
}

.tool-header-row {
    height: 1;
    width: 100%;
    layout: horizontal;
}

.tool-title-static {
    color: #f4f4f5;
    text-style: bold;
    width: 1fr;
}

.tool-status-badge {
    width: auto;
    text-style: bold;
}

.tool-status-badge.running {
    color: #38bdf8;
}

.tool-status-badge.completed {
    color: #34d399;
}

.tool-status-badge.failed {
    color: #f87171;
}

.tool-output-scroll {
    color: #d4d4d8;
    background: #09090b;
    padding: 0 1;
    margin-top: 0;
    height: auto;
    max-height: 12;
    overflow-y: auto;
}

/* ── Diff View ── */
DiffView {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    background: #111113;
    border: round #27272a;
    padding: 0 1;
}

.diff-title {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 0;
}

.diff-body {
    width: 100%;
    height: auto;
}

/* ── Prompt Input Area ── */
InputArea {
    dock: bottom;
    height: auto;
    min-height: 3;
    max-height: 8;
    background: #0d0d0f;
    padding: 0 1;
    margin-bottom: 0;
}

.input-frame {
    border: round #27272a;
    background: #141416;
    height: auto;
    min-height: 3;
    max-height: 8;
    padding: 0;
}

.input-frame:focus-within {
    border: round #22d3ee;
}

#prompt-textarea {
    width: 100%;
    height: auto;
    min-height: 2;
    max-height: 6;
    background: #141416;
    border: none;
    padding: 0 1;
}

/* ── Bottom Status Bar ── */
StatusBar {
    dock: bottom;
    height: 1;
    background: #141416;
    color: #71717a;
    padding: 0 1;
    layout: horizontal;
}

.status-left {
    width: auto;
    height: 1;
}

.status-middle {
    width: auto;
    height: 1;
    margin-left: 2;
}

.status-right {
    width: 1fr;
    height: 1;
    text-align: right;
}

/* ── Modals & Overlays ── */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}
