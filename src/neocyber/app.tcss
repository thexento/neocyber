/* NeoCyber TUI — OpenCode-inspired Styling */

Screen {
    background: #141416;
    color: #f4f4f5;
    layout: vertical;
}

/* ── Top Header / Workspace bar ── */
#header-bar {
    dock: top;
    height: 1;
    background: #18181b;
    color: #a1a1aa;
    padding: 0 1;
    layout: horizontal;
}

#header-title {
    color: #22d3ee;
    text-style: bold;
    width: auto;
}

#header-context {
    color: #71717a;
    width: 1fr;
    text-align: right;
}

/* ── Conversation Area ── */
#chat-scroll {
    height: 1fr;
    background: #141416;
    overflow-y: scroll;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: #27272a #141416;
}

/* ── Messages ── */
.message-container {
    width: 100%;
    margin-bottom: 1;
    height: auto;
}

.user-message {
    border-left: wide #22d3ee;
    padding-left: 1;
    margin-top: 1;
    margin-bottom: 1;
    background: #18181b;
    height: auto;
}

.user-header {
    color: #22d3ee;
    text-style: bold;
}

.assistant-message {
    border-left: wide #3b82f6;
    padding-left: 1;
    margin-top: 1;
    margin-bottom: 1;
    background: #161618;
    height: auto;
}

.assistant-header {
    color: #38bdf8;
    text-style: bold;
}

.plan-message {
    border-left: wide #f59e0b;
    padding-left: 1;
    margin-top: 1;
    margin-bottom: 1;
    background: #181715;
    height: auto;
}

.plan-header {
    color: #fbbf24;
    text-style: bold;
}

.message-meta {
    color: #71717a;
    text-style: italic;
    dock: right;
}

/* ── Tool Execution Box ── */
.tool-box {
    width: 100%;
    border: round #3f3f46;
    background: #18181b;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}

.tool-box.running {
    border: round #22d3ee;
}

.tool-box.completed {
    border: round #10b981;
}

.tool-box.failed {
    border: round #ef4444;
}

.tool-header-row {
    height: 1;
    width: 100%;
    layout: horizontal;
}

.tool-title {
    color: #f4f4f5;
    text-style: bold;
    width: 1fr;
}

.tool-status-badge {
    width: auto;
    text-style: bold;
}

.tool-status-badge.running {
    color: #22d3ee;
}

.tool-status-badge.completed {
    color: #10b981;
}

.tool-status-badge.failed {
    color: #ef4444;
}

.tool-output-content {
    color: #d4d4d8;
    background: #111113;
    padding: 0 1;
    margin-top: 1;
    height: auto;
    max-height: 16;
    overflow-y: auto;
}

/* ── Diff View ── */
.diff-container {
    width: 100%;
    background: #111113;
    border: round #3f3f46;
    padding: 0 1;
    margin: 1 0;
    height: auto;
}

.diff-header {
    color: #38bdf8;
    text-style: bold;
    height: 1;
}

.diff-line-add {
    color: #34d399;
    background: #064e3b;
}

.diff-line-del {
    color: #f87171;
    background: #7f1d1d;
}

.diff-line-ctx {
    color: #a1a1aa;
}

/* ── Prompt Input Area ── */
#input-container {
    dock: bottom;
    height: auto;
    max-height: 12;
    background: #141416;
    padding: 0 1;
}

#prompt-box {
    border: round #3f3f46;
    background: #18181b;
    height: auto;
    min-height: 3;
    max-height: 10;
    padding: 0;
}

#prompt-box:focus-within {
    border: round #22d3ee;
}

#prompt-textarea {
    width: 100%;
    height: auto;
    min-height: 2;
    max-height: 8;
    background: #18181b;
    border: none;
    padding: 0 1;
}

/* ── Bottom Status Bar ── */
#status-bar {
    dock: bottom;
    height: 1;
    background: #18181b;
    color: #71717a;
    padding: 0 1;
    layout: horizontal;
}

.status-agent-badge {
    text-style: bold;
    padding: 0 1;
    width: auto;
}

.status-agent-badge.cyber {
    background: #0891b2;
    color: #ffffff;
}

.status-agent-badge.plan {
    background: #d97706;
    color: #ffffff;
}

.status-item {
    color: #a1a1aa;
    padding: 0 1;
    width: auto;
}

.status-shortcuts {
    width: 1fr;
    text-align: right;
    color: #71717a;
}

/* ── Modals & Overlays ── */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

.dialog-box {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    background: #18181b;
    border: round #22d3ee;
    padding: 1 2;
}

.dialog-title {
    text-style: bold;
    color: #22d3ee;
    margin-bottom: 1;
    text-align: center;
}

.dialog-list {
    height: auto;
    max-height: 18;
    overflow-y: auto;
    margin-bottom: 1;
}

.dialog-item {
    padding: 0 1;
    height: 1;
    color: #e4e4e7;
}

.dialog-item:hover, .dialog-item.-selected {
    background: #27272a;
    color: #22d3ee;
    text-style: bold;
}
