/* NeoCyber TUI — OpenCode-grade Terminal Styling */

Screen {
    background: #121214;
    color: #f4f4f5;
    layout: vertical;
}

/* ── Top Header / Workspace bar ── */
#header-bar {
    dock: top;
    height: 1;
    background: #18181b;
    color: #a1a1aa;
    padding: 0 1;
    layout: horizontal;
}

#header-title {
    color: #22d3ee;
    text-style: bold;
    width: auto;
}

#header-context {
    color: #71717a;
    width: 1fr;
    text-align: right;
}

/* ── Conversation Area ── */
#chat-scroll, ChatArea {
    height: 1fr;
    background: #121214;
    overflow-y: scroll;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: #27272a #121214;
}

/* ── Messages & Spacing ── */
MessageView {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
}

.msg-header-row {
    height: 1;
    width: 100%;
    layout: horizontal;
    margin-bottom: 0;
    padding: 0;
}

.msg-body {
    width: 100%;
    height: auto;
    padding-left: 1;
    margin: 0;
}

.user-block {
    border-left: solid #22d3ee;
    background: #18181b;
    padding: 0 1;
    margin: 0;
}

.assistant-block {
    border-left: solid #38bdf8;
    background: #141416;
    padding: 0 1;
    margin: 0;
}

.plan-block {
    border-left: solid #f59e0b;
    background: #161517;
    padding: 0 1;
    margin: 0;
}

/* ── Tool Execution Card ── */
ToolExecutionCard {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    background: #141416;
    border: round #27272a;
    padding: 0 1;
}

ToolExecutionCard.status-running {
    border: round #0284c7;
}

ToolExecutionCard.status-completed {
    border: round #059669;
}

ToolExecutionCard.status-failed {
    border: round #dc2626;
}

.tool-header-row {
    height: 1;
    width: 100%;
    layout: horizontal;
}

.tool-title-static {
    color: #f4f4f5;
    text-style: bold;
    width: 1fr;
}

.tool-status-badge {
    width: auto;
    text-style: bold;
}

.tool-status-badge.running {
    color: #38bdf8;
}

.tool-status-badge.completed {
    color: #34d399;
}

.tool-status-badge.failed {
    color: #f87171;
}

.tool-output-scroll {
    color: #d4d4d8;
    background: #0d0d0f;
    padding: 0 1;
    margin-top: 0;
    height: auto;
    max-height: 12;
    overflow-y: auto;
}

/* ── Diff View ── */
DiffView {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    background: #0d0d0f;
    border: round #27272a;
    padding: 0 1;
}

.diff-title {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 0;
}

.diff-body {
    width: 100%;
    height: auto;
}

/* ── Prompt Input Area ── */
InputArea {
    dock: bottom;
    height: auto;
    min-height: 3;
    max-height: 8;
    background: #121214;
    padding: 0 1;
    margin-bottom: 0;
}

.input-frame {
    border: round #3f3f46;
    background: #18181b;
    height: auto;
    min-height: 3;
    max-height: 8;
    padding: 0;
}

.input-frame:focus-within {
    border: round #22d3ee;
}

#prompt-textarea {
    width: 100%;
    height: auto;
    min-height: 2;
    max-height: 6;
    background: #18181b;
    border: none;
    padding: 0 1;
}

/* ── Bottom Status Bar ── */
StatusBar {
    dock: bottom;
    height: 1;
    background: #18181b;
    color: #71717a;
    padding: 0 1;
    layout: horizontal;
}

.status-left {
    width: auto;
    height: 1;
}

.status-middle {
    width: auto;
    height: 1;
    margin-left: 2;
}

.status-right {
    width: 1fr;
    height: 1;
    text-align: right;
}

/* ── Modals & Overlays ── */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}
