#!/usr/bin/env bash
# neocyber — OpenCode-Cloned Real-Time Streaming Cybersecurity Harness
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export HERE

mode="cyber"
run=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    cyber|plan) mode="$1"; shift ;;
    --run) shift; run="${1:-}"; shift ;;
    *) shift ;;
  esac
done

if [[ -n "$run" ]]; then
  exec "$HERE/lib/engine.py" "$mode" --run "$run"
else
  exec "$HERE/lib/engine.py" "$mode"
fi
