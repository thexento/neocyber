#!/usr/bin/env bash
# neocyber — Cybersecurity AI Agent Harness (OpenCode-grade TUI)
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export HERE
export PYTHONPATH="$HERE/src:${PYTHONPATH:-}"

VENV_PY="$HERE/.venv/bin/python3"

# Check if venv python exists and has textual
if [[ -x "$VENV_PY" ]]; then
  PY_BIN="$VENV_PY"
elif command -v python3 &>/dev/null && python3 -c "import textual, rich" &>/dev/null; then
  PY_BIN="python3"
else
  printf 'Initializing NeoCyber virtual environment...\n'
  python3 -m venv "$HERE/.venv"
  "$HERE/.venv/bin/pip" install -q textual rich
  PY_BIN="$VENV_PY"
fi

exec "$PY_BIN" -m neocyber "$@"
