{
  "$schema": "https://opencode.ai/config.json",

  // Default to the local model, exposed under a short alias: ollama/cyber
  "model": "ollama/cyber",
  "default_agent": "cyber",

  "providers": {
    "ollama": {
      "models": {
        "cyber": {
          "modelID": "hf.co/bartowski/Qwen2.5-Coder-7B-Instruct-abliterated-GGUF:Q4_K_M",
          "name": "Qwen2.5-Coder 7B (local)",
          "family": "qwen2",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          // Keep this in sync with OLLAMA_CONTEXT_LENGTH (see README.md).
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
